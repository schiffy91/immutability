import Library.CLI;
import Library.Console;
import Library.FileSystem;
import Library.Platform;
import Library.Strings;
import Library.Vector;
import ./lib/Log.btrc;
import ./lib/ImmutabilityBtrfs.btrc;
import ./lib/ImmutabilityConfig.btrc;
import ./lib/ImmutabilityConstants.btrc;
import ./lib/ImmutabilityFs.btrc;
import ./lib/ImmutabilityMaterializer.btrc;
import ./lib/ImmutabilityMounts.btrc;
import ./lib/ImmutabilityOrphans.btrc;
import ./lib/ImmutabilityPaths.btrc;
import ./lib/ImmutabilityPlanner.btrc;
import ./lib/ImmutabilityRun.btrc;
import ./lib/ImmutabilitySlots.btrc;
import ./lib/Leftovers.btrc;
import ./lib/DiffScanner.btrc;
import ./lib/Settings.btrc;
import ./lib/SnapshotManager.btrc;
import ./lib/Types.btrc;

class Immutability {
    public ImmutabilityRun run;
    public ImmutabilityFs fs;
    public ImmutabilityPlanner planner;
    public ImmutabilityMaterializer materializer;
    public ImmutabilityMounts mounts;
    public ImmutabilitySlots slots;
    public ImmutabilityOrphans orphans;
    public string device;
    public string snapshotsSubvolume;
    public string cleanName;
    public string base;
    public string mode;
    public string persistRoot;
    public string specFile;
    public Vector<ImmutabilitySpec> specs;
    public Vector<ImmutabilityVolume> volumes;
    public bool assumeMounted;
    public int keepGenerations;
    public int restoreGeneration;

    public Immutability(bool dryRun, bool assumeMounted) {
        self.run = ImmutabilityRun(dryRun);
        self.fs = ImmutabilityFs(self.run);
        self.planner = ImmutabilityPlanner(self.fs);
        self.mounts = ImmutabilityMounts(self.run, self.fs);
        self.materializer = ImmutabilityMaterializer(self.run, self.fs);
        self.slots = ImmutabilitySlots(self.fs, self.run);
        self.orphans = ImmutabilityOrphans(self.fs, self.run);
        self.device = "";
        self.snapshotsSubvolume = "";
        self.cleanName = "";
        self.base = ImmutabilityConstants.clean();
        self.mode = "";
        self.persistRoot = "";
        self.specFile = "";
        self.specs = [];
        self.volumes = [];
        self.assumeMounted = assumeMounted;
        self.keepGenerations = 3;
        self.restoreGeneration = 1;
    }

    class bool envDryRun() {
        var value = Environment.get("IMMUTABILITY_DRY_RUN", "");
        return value.equals("1") || value.equals("true") || value.equals("yes") || value.equals("on");
    }

    public Vector<ImmutabilitySpec> specsForVolume(string volume) {
        Vector<ImmutabilitySpec> result = [];
        for spec in self.specs {
            if (spec.volume.equals(volume)) { result.push(spec); }
        }
        return result;
    }

    public bool emptyBase() { return self.base.equals(ImmutabilityConstants.empty()); }

    public void requireLiveAndClean(string live, string clean) {
        if (!clean.isEmpty() && (!self.fs.exists(clean) || !self.fs.isSubvolume(clean) || !self.fs.isReadonly(clean))) {
            self.run.fatal(f"bad CLEAN: {clean}");
        }
        if (!self.fs.exists(live)) { self.run.fatal(f"live missing: {live}"); }
        if (!self.fs.isSubvolume(live)) { self.run.fatal(f"live is not a subvolume: {live}"); }
    }

    public string volumeRoot(ImmutabilityVolume volume) {
        return PathTools.join(self.snapshotsSubvolume, volume.name);
    }

    public string cleanPath(ImmutabilityVolume volume) {
        if (self.emptyBase()) { return ""; }  /* a reset from nothing has no snapshot */
        return self.run.path(PathTools.join(self.volumeRoot(volume), self.cleanName));
    }

    public string nextPath(ImmutabilityVolume volume) {
        return self.run.path(PathTools.join(self.volumeRoot(volume), ImmutabilityConstants.next()));
    }

    public void prepareVolume(ImmutabilityVolume volume) {
        var live = self.run.path(volume.name);
        var clean = self.cleanPath(volume);
        var next = self.nextPath(volume);

        if (!self.fs.exists(live)) {
            self.slots.publish(volume, live, next);
        }
        self.requireLiveAndClean(live, clean);
        self.fs.deleteSubvolume(next);

        var plans = self.planner.makePlan(self.specsForVolume(volume.name), live, clean, self.persistRoot);
        self.restorePersistentDirs(plans, live, clean);
        self.restorePersistentFiles(plans, live, clean);

        self.slots.rotate(volume.name, live, self.snapshotsSubvolume, self.keepGenerations);
        if (self.emptyBase()) {
            self.fs.makeSubvolume(next);
            self.fs.matchOwnerAndMode(live, next);
        } else {
            self.fs.snapshot(clean, next, false);
        }
        self.populateNext(plans, live, next);
        if (!self.fs.exists(next) || !self.fs.isSubvolume(next)) {
            self.run.fatal(f"prepared NEXT missing: {next}");
        }
        self.run.log(f"Prepared {volume.name} NEXT");
    }

    public void publishPreparedVolume(ImmutabilityVolume volume) {
        var live = self.run.path(volume.name);
        var next = self.nextPath(volume);
        if (!self.fs.exists(next) || !self.fs.isSubvolume(next)) {
            self.run.fatal(f"prepared NEXT missing: {next}");
        }
        if (self.fs.exists(live) && !self.fs.isSubvolume(live)) {
            self.run.fatal(f"live is not a subvolume: {live}");
        }
        self.run.log(f"Publishing prepared NEXT for {volume.name}");
        self.slots.publish(volume, live, next);
    }

    public void resetVolume(ImmutabilityVolume volume) {
        self.prepareVolume(volume);
        self.publishPreparedVolume(volume);
    }

    public void restorePersistentDirs(Vector<ImmutabilityPlan> plans, string live, string clean) {
        for plan in plans {
            if (!plan.kind.equals("dir")) { continue; }
            var store = self.run.path(plan.store);
            if (!self.fs.exists(store)) {
                self.fs.seedSubvolume(store, self.fs.sourcePath(live, clean, plan.spec.relativePath));
            } else if (!self.fs.isSubvolume(store)) {
                self.run.fatal(f"not a subvolume: {store}");
            }
        }
    }

    public void restorePersistentFiles(Vector<ImmutabilityPlan> plans, string live, string clean) {
        for plan in plans {
            if (!plan.kind.equals("file")) { continue; }
            var destination = self.run.path(plan.store);
            var source = self.fs.sourcePath(live, clean, plan.spec.relativePath);
            if (!source.isEmpty()) {
                var temporary = f"{destination}.tmp.{Platform.pid()}";
                self.run.removePath(temporary);
                self.fs.copyPath(source, temporary);
                self.run.removePath(destination);
                self.run.renamePath(temporary, destination);
            } else {
                self.run.removePath(destination);
            }
        }
    }

    public void populateNext(Vector<ImmutabilityPlan> plans, string live, string next) {
        for plan in plans {
            var target = PathTools.join(next, plan.spec.relativePath);
            self.run.removePath(target);
            if (plan.kind.equals("dir")) {
                if (self.emptyBase()) {
                    self.run.mkdirpFollowing(next, plan.spec.relativePath, live);  /* nothing to inherit from: take the last root's owners */
                } else {
                    self.run.mkdirpInheriting(target);
                }
            } else {
                var source = self.run.path(plan.store);
                if (self.fs.exists(source)) {
                    if (self.emptyBase()) { self.run.mkdirpFollowing(next, PathTools.dirname(plan.spec.relativePath), live); }
                    self.fs.copyPath(source, target);
                }
            }
        }
    }

    public void configure(string device, string snapshotsSubvolume, string cleanName, string mode, string persistRoot, string specFile, Vector<string> volumeArgs) {
        self.device = device;
        self.snapshotsSubvolume = ImmutabilityPaths.normSubvol(snapshotsSubvolume);
        self.cleanName = cleanName.trim();
        self.mode = mode.trim();
        self.persistRoot = ImmutabilityPaths.normSubvol(persistRoot);
        self.specFile = specFile;
        self.specs = ImmutabilityConfig.readSpecs(self.specFile);
        self.volumes = ImmutabilityConfig.readVolumes(volumeArgs, self.specs);
    }

    public bool modeIn(Vector<string> modes) {
        for mode in modes {
            if (self.mode.equals(mode)) { return true; }
        }
        return false;
    }

    public bool resetMode() {
        return self.modeIn([
            ImmutabilityConstants.converge(),
            ImmutabilityConstants.reset()
        ]);
    }

    public bool prepareMode() {
        return self.resetMode() || self.mode.equals(ImmutabilityConstants.prepareOnly());
    }

    public string logPath() {
        var logs = PathTools.join(PathTools.join(self.snapshotsSubvolume, ImmutabilityConstants.meta()), "logs");
        return self.run.path(PathTools.join(logs, f"immutability-{Platform.pid()}.log"));
    }

    public Vector<ImmutabilityPlan> plansForAllVolumes() {
        Vector<ImmutabilityPlan> result = [];
        for volume in self.volumes {
            var live = self.run.path(volume.name);
            var clean = self.cleanPath(volume);
            var specs = self.mounts.selectedSpecs(self.specsForVolume(volume.name));
            var plans = self.planner.makePlan(specs, live, clean, self.persistRoot);
            for plan in plans {
                result.push(plan);
            }
        }
        return result;
    }

    public void runVolume(ImmutabilityVolume volume) {
        if (self.resetMode()) {
            self.resetVolume(volume);
            return;
        }
        if (self.mode.equals(ImmutabilityConstants.prepareOnly())) {
            self.prepareVolume(volume);
            return;
        }
        if (self.mode.equals(ImmutabilityConstants.publishPrepared())) {
            self.publishPreparedVolume(volume);
            return;
        }
        if (self.mode.equals(ImmutabilityConstants.snapshotOnly())) {
            self.slots.rotate(volume.name, self.run.path(volume.name), self.snapshotsSubvolume, self.keepGenerations);
            return;
        }
        if (self.modeIn([ImmutabilityConstants.restoreA(), ImmutabilityConstants.restorePrevious()])) {
            self.slots.restoreGeneration(volume, 1, self.snapshotsSubvolume);
            return;
        }
        if (self.modeIn([ImmutabilityConstants.restoreB(), ImmutabilityConstants.restorePenultimate()])) {
            self.slots.restoreGeneration(volume, 2, self.snapshotsSubvolume);
            return;
        }
        if (self.mode.equals(ImmutabilityConstants.restoreC())) {
            self.slots.restoreGeneration(volume, 3, self.snapshotsSubvolume);
            return;
        }
        if (self.mode.equals(ImmutabilityConstants.restoreGeneration())) {
            self.slots.restoreGeneration(volume, self.restoreGeneration, self.snapshotsSubvolume);
            return;
        }
        self.run.fatal(f"Unknown mode: {self.mode}");
    }

    public void runAll() {
        Vector<string> names = [];
        for volume in self.volumes { names.push(volume.name); }
        var dryRun = self.run.dryRun ? "true" : "false";
        var subvolumes = names.join(" ");
        self.run.log(f"Mode={self.mode} dry_run={dryRun} device={self.device} subvolumes={subvolumes}");
        if (self.mode.equals(ImmutabilityConstants.disabled())) {
            self.run.log("Immutability disabled; skipping");
            return;
        }
        if (self.run.dryRun && !self.assumeMounted) {
            self.run.log("DRY add --assume-mounted to walk mounted test roots");
            return;
        }
        self.mounts.mountTop(self.device, self.assumeMounted);
        try {
            self.run.enableFileLog(self.logPath());
            if (!self.mode.equals(ImmutabilityConstants.publishPrepared())) {
                self.orphans.ensureNamespaces(self.persistRoot);
            }
            if (self.prepareMode()) {
                self.orphans.pruneOrphans(self.persistRoot, self.plansForAllVolumes());
            }
            for volume in self.volumes {
                self.runVolume(volume);
            }
            self.run.require(ImmutabilityBtrfs.sync(self.run.top));
        } finally {
            self.mounts.unmountTop(self.assumeMounted);
        }
        self.run.log("Immutability complete");
    }

    public void printPlan() {
        self.mounts.mountTop(self.device, self.assumeMounted);
        try {
            for volume in self.volumes {
                var live = self.run.path(volume.name);
                var clean = self.cleanPath(volume);
                var next = self.nextPath(volume);
                self.requireLiveAndClean(live, clean);
                var plans = self.planner.makePlan(self.mounts.selectedSpecs(self.specsForVolume(volume.name)), live, clean, self.persistRoot);
                var nextExists = self.fs.exists(next) ? "true" : "false";
                Console.log(f"volume {volume.name} {volume.mountPoint}");
                Console.log(f"  live {live}");
                Console.log(self.emptyBase() ? "  base empty" : f"  clean {clean}");
                Console.log(f"  next {next} exists={nextExists}");
                for plan in plans {
                    Console.log(f"  keep {plan.kind} {plan.spec.absPath} -> {plan.store}");
                }
            }
        } finally {
            self.mounts.unmountTop(self.assumeMounted);
        }
    }

    // What nothing removes by itself is listed, and deleted only when that is asked for.
    public void collect(bool deleting, int olderThan) {
        self.mounts.mountTop(self.device, self.assumeMounted);
        try {
            Vector<string> names = [];
            for volume in self.volumes { names.push(volume.name); }
            var leftovers = Leftovers(self.fs, self.run);
            var found = leftovers.find(self.persistRoot, self.snapshotsSubvolume, names, Leftovers.today(), olderThan);
            for leftover in found {
                Console.log(leftover.line().replace(self.run.top + "/", ""));
                if (deleting) { leftovers.remove(leftover); }
            }
            if (found.isEmpty()) {
                Console.log("nothing is left over");
            } else if (deleting) {
                self.run.require(ImmutabilityBtrfs.sync(self.run.top));
                Console.log(f"deleted: {found.length}");
            } else {
                Console.log(f"left over: {found.length}. Nothing was deleted; `immutability gc --delete` deletes what is listed");
            }
        } finally {
            self.mounts.unmountTop(self.assumeMounted);
        }
    }

    public void configureMount(string device, string persistRoot, string specFile) {
        self.device = device;
        self.persistRoot = ImmutabilityPaths.normSubvol(persistRoot);
        self.specFile = specFile;
        self.specs = ImmutabilityConfig.readSpecs(self.specFile);
    }

    public void mountPersist() {
        self.mounts.mountPersist(self.device, self.persistRoot, self.specs, self.assumeMounted);
    }

    public void materializePersist() {
        self.mounts.mountTop(self.device, self.assumeMounted);
        try {
            self.orphans.ensureNamespaces(self.persistRoot);
            for volume in self.volumes {
                var live = self.run.path(volume.name);
                var clean = self.cleanPath(volume);
                self.requireLiveAndClean(live, clean);
                var specs = self.mounts.selectedSpecs(self.specsForVolume(volume.name));
                var plans = self.planner.makePlan(specs, live, clean, self.persistRoot);
                self.materializer.materialize(plans, self.persistRoot);
            }
            self.run.require(ImmutabilityBtrfs.sync(self.run.top));
        } finally {
            self.mounts.unmountTop(self.assumeMounted);
        }
        self.run.log("Persistent data materialized");
    }

    // The commands a person runs take what they need from the settings the module wrote, not from arguments.
    class int fromSettings(CLICommandLine parsed, string command, bool dryRun, bool assumeMounted) {
        var settings = Settings(parsed.option("--settings", Settings.defaultPath()));
        var refresh = parsed.flag("--refresh-clean");
        if (refresh && settings.base.equals(ImmutabilityConstants.empty())) {
            Log.fatal("the base is empty: resets start from nothing, so there is no CLEAN snapshot to refresh");
        }
        var immutability = Immutability(dryRun, assumeMounted);
        immutability.keepGenerations = settings.keepGenerations;
        immutability.restoreGeneration = settings.restoreGeneration;
        immutability.base = settings.base;
        var mode = command.equals("materialize") ? ImmutabilityConstants.disabled() : ImmutabilityConstants.prepareOnly();
        immutability.configure(settings.device, settings.snapshotsSubvolume, settings.cleanName, mode, settings.persistRoot, settings.specFile, settings.volumes);
        if (command.equals("plan")) {
            immutability.printPlan();
        } else if (command.equals("prepare")) {
            immutability.runAll();
        } else {
            immutability.materializePersist();
            if (refresh && !dryRun) { SnapshotManager(settings).createInitialSnapshots(); }
        }
        return 0;
    }

    class int gc(CLICommandLine parsed, bool dryRun, bool assumeMounted) {
        var settings = Settings(parsed.option("--settings", Settings.defaultPath()));
        var days = parsed.option("--older-than", "30");  /* a store set aside lately may be wanted back */
        if (days.isEmpty() || !days.isDigit()) { Log.fatal("--older-than takes a number of days"); }
        var immutability = Immutability(dryRun, assumeMounted);
        immutability.base = settings.base;
        immutability.configure(settings.device, settings.snapshotsSubvolume, settings.cleanName, ImmutabilityConstants.disabled(), settings.persistRoot, settings.specFile, settings.volumes);
        immutability.collect(parsed.flag("--delete"), Strings.toInt(days));
        return 0;
    }

    class int diff(CLICommandLine parsed) {
        var options = DiffOptions();
        options.recent = parsed.flag("--recent");
        options.showSymlinks = parsed.flag("--show-symlinks");
        options.showPersistPaths = parsed.flag("--show-persist-paths");
        options.showChildren = parsed.option("--show-children", "");
        var depth = parsed.option("--depth", "");
        if (!depth.isEmpty()) { options.depth = Strings.toInt(depth); }
        options.pattern = parsed.option("--pattern", "");
        options.diffignore = parsed.option("--diffignore", "");
        DiffScanner(Settings(parsed.option("--settings", Settings.defaultPath()))).print(options);
        return 0;
    }

    // `snapshots create` takes a volume's CLEAN snapshot. An installer names everything itself and gives the
    // root it installed into; on a running machine the settings say it all.
    class int snapshots(CLICommandLine parsed, string base) {
        if (!parsed.operand(1).equals("create")) {
            Console.error("Usage: immutability snapshots create [--root <dir> --base clean|empty --snapshots-mount <path> --clean-name <name> name=mount ...]");
            return 1;
        }
        var named = !parsed.option("--snapshots-mount", "").isEmpty();
        var settings = named ? Settings() : Settings(parsed.option("--settings", Settings.defaultPath()));
        if (named) {
            settings.snapshotsMountPoint = parsed.option("--snapshots-mount");
            settings.cleanName = parsed.option("--clean-name", settings.cleanName);
            settings.base = base;
            for (int i = 2; i < parsed.operandCount(); i++) { settings.volumes.push(parsed.operand(i)); }
        }
        var manager = SnapshotManager(settings);
        manager.rootPrefix = parsed.option("--root", "");
        manager.createInitialSnapshots();
        return 0;
    }

    class int cli(CLIArgs args) {
        try {
            var parsed = CLICommandLine.parse(args);
            var dryRun = Immutability.envDryRun() || parsed.flag("--dry-run");
            var assumeMounted = parsed.flag("--assume-mounted");
            var keepGenerations = Strings.toInt(parsed.option("--keep-generations", "3"));
            var restoreGeneration = Strings.toInt(parsed.option("--restore-generation", "1"));
            if (keepGenerations < 0) { Log.fatal("--keep-generations must be >= 0"); }
            if (restoreGeneration < 1) { Log.fatal("--restore-generation must be >= 1"); }
            var base = parsed.option("--base", ImmutabilityConstants.clean());
            if (!base.equals(ImmutabilityConstants.clean()) && !base.equals(ImmutabilityConstants.empty())) { Log.fatal("--base must be clean or empty"); }
            var command = parsed.operand(0);
            if (command.equals("diff")) { return Immutability.diff(parsed); }
            if (command.equals("snapshots")) { return Immutability.snapshots(parsed, base); }
            if (command.equals("gc")) { return Immutability.gc(parsed, dryRun, assumeMounted); }
            if (parsed.operandCount() == 1 && (command.equals("plan") || command.equals("prepare") || command.equals("materialize"))) {
                return Immutability.fromSettings(parsed, command, dryRun, assumeMounted);
            }
            if (parsed.operand(0).equals("mount")) {
                if (parsed.operandCount() < 4) {
                    Console.error("Usage: immutability [--dry-run] mount <device> <persist_root> <spec_file>");
                    return 1;
                }
                var mounter = Immutability(dryRun, assumeMounted);
                mounter.configureMount(parsed.operand(1), parsed.operand(2), parsed.operand(3));
                mounter.mountPersist();
                return 0;
            }
            if (parsed.operand(0).equals("materialize")) {
                if (parsed.operandCount() < 6) {
                    Console.error("Usage: immutability [--dry-run] [--assume-mounted] materialize <device> <snapshots> <clean> <persist_root> <spec_file> [name=mount ...]");
                    return 1;
                }
                Vector<string> volumeArgs = [];
                for (int i = 6; i < parsed.operandCount(); i++) {
                    volumeArgs.push(parsed.operand(i));
                }
                var materializer = Immutability(dryRun, assumeMounted);
                materializer.keepGenerations = keepGenerations;
                materializer.base = base;
                materializer.restoreGeneration = restoreGeneration;
                materializer.configure(
                    parsed.operand(1),
                    parsed.operand(2),
                    parsed.operand(3),
                    ImmutabilityConstants.disabled(),
                    parsed.operand(4),
                    parsed.operand(5),
                    volumeArgs
                );
                materializer.materializePersist();
                return 0;
            }
            if (parsed.operand(0).equals("plan") || parsed.operand(0).equals("prepare")) {
                if (parsed.operandCount() < 6) {
                    Console.error("Usage: immutability [--dry-run] [--assume-mounted] <plan|prepare> <device> <snapshots> <clean> <persist_root> <spec_file> [name=mount ...]");
                    return 1;
                }
                Vector<string> volumeArgs = [];
                for (int i = 6; i < parsed.operandCount(); i++) {
                    volumeArgs.push(parsed.operand(i));
                }
                var immutability = Immutability(dryRun, assumeMounted);
                immutability.keepGenerations = keepGenerations;
                immutability.restoreGeneration = restoreGeneration;
                immutability.base = base;
                immutability.configure(
                    parsed.operand(1),
                    parsed.operand(2),
                    parsed.operand(3),
                    ImmutabilityConstants.prepareOnly(),
                    parsed.operand(4),
                    parsed.operand(5),
                    volumeArgs
                );
                if (parsed.operand(0).equals("plan")) {
                    immutability.printPlan();
                } else {
                    immutability.runAll();
                }
                return 0;
            }
            if (parsed.operandCount() < 6) {
                Console.error("Usage: immutability [--dry-run] [--assume-mounted] [--base clean|empty] <device> <snapshots> <clean> <mode> <persist_root> <spec_file> [name=mount ...]");
                return 1;
            }
            Vector<string> volumeArgs = [];
            for (int i = 6; i < parsed.operandCount(); i++) {
                volumeArgs.push(parsed.operand(i));
            }
            var immutability = Immutability(dryRun, assumeMounted);
            immutability.keepGenerations = keepGenerations;
            immutability.restoreGeneration = restoreGeneration;
            immutability.base = base;
            immutability.configure(
                parsed.operand(0),
                parsed.operand(1),
                parsed.operand(2),
                parsed.operand(3),
                parsed.operand(4),
                parsed.operand(5),
                volumeArgs
            );
            immutability.runAll();
            return 0;
        } catch (string error) {
            Log.error(error);
        }
        return 1;
    }
}

int main(int argc, char** argv) {
    var args = CLIArgs(argc, argv);
    return Immutability.cli(args);
}
