import Library.FileSystem;
import Library.Process;
import Library.Vector;
import ./ImmutabilityBtrfs.btrc;
import ./ImmutabilityConstants.btrc;
import ./ImmutabilityFs.btrc;
import ./ImmutabilityPaths.btrc;
import ./ImmutabilityRun.btrc;
import ./Types.btrc;

class ImmutabilityMounts {
    public ImmutabilityRun run;
    public ImmutabilityFs fs;

    public ImmutabilityMounts(ImmutabilityRun run, ImmutabilityFs fs) {
        self.run = run;
        self.fs = fs;
    }

    public void mountTop(string device, bool assumeMounted) {
        if (assumeMounted) {
            if (!FileSystem.isDir(self.run.top)) {
                self.run.fatal(f"missing mount path: {self.run.top}");
            }
            return;
        }
        self.run.mkdirp(self.run.top);
        self.run.require(f"mount -t btrfs -o subvolid=5,user_subvol_rm_allowed {ShellWords.quote(device)} {ShellWords.quote(self.run.top)}");
    }

    public void unmountTop(bool assumeMounted) {
        if (assumeMounted) { return; }
        var unmounted = self.run.run(f"umount -R {ShellWords.quote(self.run.top)}", stdout=COMMAND_OUTPUT_STREAM, stderr=COMMAND_OUTPUT_STREAM, logFailure=false);
        if (!unmounted.ok()) {
            self.run.fatal(f"failed to unmount: {self.run.top}");
        }
        if (self.fs.mounted(self.run.top)) {
            self.run.fatal(f"still mounted after unmount: {self.run.top}");
        }
        var topPrefix = f"{ImmutabilityConstants.topBase()}.";
        if (self.run.top.startsWith(topPrefix)) {
            FileSystem.removeRecursive(self.run.top);
        }
    }

    public bool coveredBy(Vector<string> selected, string target) {
        for s in selected {
            var prefix = f"{s}/";
            if (target.startsWith(prefix)) { return true; }
        }
        return false;
    }

    // The line of a mount table that mounts the store `subvol` at `target`.
    public string mountLine(string device, string target, string subvol) {
        var options = f"subvol={subvol},compress=zstd,noatime";
        return f"{ImmutabilityFs.mountWord(device)} {ImmutabilityFs.mountWord(target)} btrfs {ImmutabilityFs.mountWord(options)} 0 0";
    }

    // Every line of `table` mounted by one `mount`, not by a child for each, and each target looked at after.
    public void mountAll(Vector<string> table, Vector<string> targets) {
        if (table.isEmpty()) { return; }
        if (self.run.dryRun) {
            for line in table { self.run.log(f"DRY mount {line}"); }
            return;
        }
        var file = f"{self.run.top}.mounts";
        if (!FileSystem.writeAtomic(file, table.join("\n") + "\n", 0o600)) { self.run.fatal(f"cannot write the mount table: {file}"); }
        try {
            self.run.require(f"mount --all --fstab {ShellWords.quote(file)}");
        } finally {
            FileSystem.removeIfExists(file);
        }
        var points = self.fs.mountPoints();
        for target in targets {
            if (!self.fs.mountedAmong(points, target)) { self.run.fatal(f"not mounted after mount: {target}"); }
        }
    }

    public bool persistAsDirectory(ImmutabilitySpec spec) {
        if (spec.kind.equals("dir")) { return true; }
        if (spec.kind.equals("file")) { return false; }
        return FileSystem.isDir(spec.absPath);
    }

    public void ensurePersistentSubvolume(ImmutabilitySpec spec, string persistentSubvolume) {
        if (self.fs.isSubvolume(persistentSubvolume)) { return; }
        if (!self.persistAsDirectory(spec)) { return; }
        self.fs.seedSubvolume(persistentSubvolume, self.fs.exists(spec.absPath) ? spec.absPath : "");
    }

    public Vector<ImmutabilitySpec> selectedSpecs(Vector<ImmutabilitySpec> specs) {
        Vector<ImmutabilitySpec> selected = [];
        Vector<string> targets = [];
        for spec in specs {
            var target = spec.absPath;
            if (self.coveredBy(targets, target)) { continue; }
            targets.push(target);
            selected.push(spec);
        }
        return selected;
    }

    public void mountPersist(string device, string persistRoot, Vector<ImmutabilitySpec> specs, bool assumeMounted) {
        var dryRun = self.run.dryRun ? "true" : "false";
        self.run.log(f"Mounting persistent subvolumes dry_run={dryRun}");
        var mountedTop = false;
        if (!assumeMounted && !self.fs.mounted(self.run.top)) {
            self.run.mkdirp(self.run.top);
            self.run.require(f"mount -t btrfs -o subvolid=5 {ShellWords.quote(device)} {ShellWords.quote(self.run.top)}");
            mountedTop = true;
        }
        try {
            var selected = self.selectedSpecs(specs);
            var stores = PathTools.join(persistRoot, ImmutabilityConstants.dirs());
            Vector<string> known = [];
            if (!self.run.dryRun) { known = self.fs.childSubvolumes(self.run.path(stores)); }  /* one listing, not a question for each store */
            self.run.log(f"{known.len} stores listed");
            Vector<string> table = [];
            Vector<string> targets = [];
            var points = self.fs.mountPoints();  /* nothing in this loop mounts at a target */
            for spec in selected {
                var target = spec.absPath;
                var subvol = PathTools.join(stores, ImmutabilityPaths.key(target));
                if (!known.contains(self.run.path(subvol))) {
                    self.ensurePersistentSubvolume(spec, self.run.path(subvol));
                    if (!self.fs.isSubvolume(self.run.path(subvol))) { continue; }
                }
                self.run.mkdirp(target);
                if (self.fs.mountedAmong(points, target)) { continue; }
                table.push(self.mountLine(device, target, subvol));
                targets.push(target);
            }
            self.mountAll(table, targets);
        } finally {
            if (mountedTop) {
                self.unmountTop(false);
            }
        }
        self.run.log("Persistent mounts complete");
    }

}
