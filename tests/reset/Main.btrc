import Library.CLI;
import Library.JSON;
import Library.Process;
import testkit.Lab;

// A machine whose root and home are btrfs subvolumes that reset at every boot, on either base: what is
// persisted outlives a reset with its owners, what is not is gone, earlier roots are kept and one can be
// put back, a store nothing names any more is set aside, and the commands a person runs work from the
// settings the module wrote.
class ResetScenario {
    private Guest machine;
    private bool clean;
    private string tool;

    public ResetScenario(Guest machine, string base) {
        self.machine = machine;
        self.clean = base == "clean";
        self.tool = f"immutability --base {base} --keep-generations 3 -- /dev/vdb @snapshots CLEAN";
    }

    private void booted() {
        self.machine.waitForUnit("multi-user.target", 180);
        self.machine.succeed("mkdir -p /run/top && (mountpoint -q /run/top || mount -t btrfs -o subvolid=5 /dev/vdb /run/top)");
    }

    private void again() {  // the machine goes down and comes up from the same disk
        self.machine.reboot();
        self.machine.waitForShutdown();
        self.machine.start();
        self.booted();
    }

    private string read(string path) { return self.machine.succeed(f"cat {ShellWords.quote(path)}").trim(); }

    private void firstBoot() {
        print("The first boot resets too: the root is the base, with the persisted paths in place");
        self.booted();
        Check.equal(self.read("/.snapshots/.immutability/version"), "2026.11.17", "the run recorded its version");
        Check.equal(self.read("/.snapshots/.immutability/format"), "3", "and the number of the layout it left");
        self.machine.succeed("findmnt -rn -o SOURCE --target / | grep -F '[/@root]'");
        var parent = self.machine.succeed("btrfs subvolume show / | sed -n 's/^\\s*Parent UUID:\\s*//p'").trim();
        if (self.clean) {
            Check.equal(self.read("/etc/installed"), "from the installer", "what CLEAN holds is there");
            Check.equal(parent, self.machine.succeed("btrfs subvolume show /.snapshots/@root/CLEAN | sed -n 's/^\\s*UUID:\\s*//p'").trim(), "the root is a copy of CLEAN");
        } else {
            self.machine.succeed("test ! -e /.snapshots/@root/CLEAN && test ! -e /.snapshots/@home/CLEAN");
            Check.equal(parent, "-", "the root is a new subvolume, a copy of nothing");
        }
        self.machine.succeed("findmnt -rn -o SOURCE --target /var/keep | grep -F '@persist/dirs/var!keep'");
        Check.equal(self.machine.succeed("stat -c %U:%a /home/alice").trim(), "alice:700", "the home folder is its user's");
        self.machine.succeed("echo ephemeral > /root-file && echo kept > /var/keep/data && echo kept-file > /etc/keep-file && echo ALPHA > /home/generation-marker");
        self.machine.succeed("su alice -c 'echo ephemeral > ~/scratch && mkdir -m 750 ~/kept && echo mine > ~/kept/note'");
        print("A folder holding a file that cannot be cloned is persisted all the same, at once and at the next boot");
        // A database or a search index is marked no-copy-on-write, and btrfs refuses to clone such a file into a new subvolume.
        var index = "mkdir {0} && touch {0}/data && chattr +C {0}/data && echo indexed > {0}/data && echo beside > {0}/plain && lsattr {0}/data | grep -q -- '-C-'";
        self.machine.succeed(index.replace("{0}", "/var/index-live"));
        self.machine.succeed("systemctl restart persistence-mounts.service", 120);  // what a switch to a configuration with a new path does
        self.machine.succeed("findmnt -rn -o SOURCE --target /var/index-live | grep -F '@persist/dirs/var!index-live'");
        Check.equal(self.read("/var/index-live/data") + " " + self.read("/var/index-live/plain"), "indexed beside", "its contents are in the store it is now mounted from");
        self.machine.succeed(index.replace("{0}", "/var/index-boot"));
        self.machine.succeed("btrfs subvolume create '/run/top/@persist/dirs/stray!store' && echo left > '/run/top/@persist/dirs/stray!store/file' && sync");
    }

    private void afterReset() {
        print("After a reset what was persisted is there with its owners, and the rest is gone");
        self.again();
        self.machine.succeed("test ! -e /root-file && test ! -e /home/alice/scratch && test ! -e /home/generation-marker");
        Check.equal(self.machine.succeed("journalctl -k -b --no-pager | grep -c 'first mount of filesystem'").trim(), "1", "the filesystem was mounted once: the reset held it until the root was mounted, and did not unmount it in between");
        self.machine.succeed("! findmnt /run/immutability-version-top && test ! -e /run/immutability-version-top");  // and the reset's own mount was let go
        Check.equal(self.read("/.snapshots/.immutability/version"), "2026.11.17", "the version is still recorded");
        Check.equal(self.read("/var/keep/data"), "kept", "a persisted directory");
        Check.equal(self.read("/etc/keep-file"), "kept-file", "a persisted file");
        Check.equal(self.read("/home/alice/kept/note"), "mine", "a directory the user made, persisted from then on");
        self.machine.succeed("findmnt -rn -o SOURCE --target /home/alice/kept | grep -F '@persist/dirs/home!alice!kept'");
        Check.equal(self.machine.succeed("stat -c %U:%a /home/alice/kept").trim(), "alice:750", "with its owner and mode");
        Check.equal(self.machine.succeed("stat -c %U:%a /home/alice").trim(), "alice:700", "and the folder above it is still its user's");
        self.machine.succeed("su alice -c 'echo again > ~/kept/second'");
        Check.equal(self.read("/var/index-live/data") + " " + self.read("/var/index-boot/data") + " " + self.read("/var/index-boot/plain"), "indexed indexed beside", "both folders with a file that cannot be cloned");
        self.machine.succeed("findmnt -rn -o SOURCE --target /var/index-boot | grep -F '@persist/dirs/var!index-boot' && test ! -e '/run/top/@persist/dirs/var!index-boot.filling'");
        if (self.clean) { Check.equal(self.read("/etc/installed"), "from the installer", "CLEAN's content is back"); }

        print("The root before it is kept as a generation, and a store nothing names is set aside");
        Check.equal(self.read("/.snapshots/@root/generation-1/root-file"), "ephemeral", "generation 1 of the root");
        Check.equal(self.read("/.snapshots/@home/generation-1/generation-marker"), "ALPHA", "generation 1 of the home volume");
        self.machine.succeed("test ! -e '/run/top/@persist/dirs/stray!store' && test \"$(cat /run/top/@persist/.orphans/stray\\!store-*/file)\" = left");
    }

    private void restore() {
        print("An earlier generation of a volume can be put back");
        self.machine.succeed("umount /home/alice/kept && umount /home");
        self.machine.succeed(f"{self.tool} restore-a @persist /etc/immutability/spec.toml @home=/home", 120);
        self.machine.succeed("mount /home");
        Check.equal(self.read("/home/generation-marker"), "ALPHA", "the home volume as it was one boot ago");
    }

    private void commands() {
        print("diff lists what changed and leaves out what is persisted");
        self.machine.succeed("systemctl start immutability-marker.service 2>/dev/null || true");
        self.machine.succeed("mkdir /diff-canary && dd if=/dev/zero of=/diff-canary/file bs=4096 count=16 status=none && echo more > /var/keep/data && sync");
        var changed = self.machine.succeed("immutability diff 2>&1", 120);
        Check.that(changed.contains("/diff-canary"), "a new directory on the root is listed");
        Check.that(!changed.contains("/var/keep"), "a persisted path is not");

        print("plan says what a reset would keep; materialize copies what is persisted back into the volume");
        var plan = self.machine.succeed("immutability plan 2>&1", 120);
        Check.that(plan.contains("keep dir /var/keep") && plan.contains("keep file /etc/keep-file"), "the plan names the persisted paths");
        Check.that(plan.contains(self.clean ? "clean " : "base empty"), "and the base");
        if (self.clean) {
            self.machine.succeed("echo second-base > /etc/second && sync && immutability materialize --refresh-clean", 180);
            Check.equal(self.read("/.snapshots/@root/CLEAN/etc/second"), "second-base", "CLEAN is the root as it is now");
            Check.equal(self.read("/.snapshots/@root/CLEAN/var/keep/data"), "more", "with what was persisted copied into it");
            self.again();
            Check.equal(self.read("/etc/second"), "second-base", "and the next reset starts from it");
        } else {
            Check.that(self.machine.fail("immutability materialize --refresh-clean 2>&1").contains("no CLEAN snapshot to refresh"), "with nothing to refresh, refreshing is refused");
            self.machine.succeed("immutability materialize", 180);
            self.machine.succeed("immutability snapshots create && test ! -e /.snapshots/@root/CLEAN");
        }
    }

    // What an earlier generation meets when it is booted again after a newer one changed the layout.
    private void notReset(string layout, string words) {
        self.machine.succeed(f"echo left > /left-by-the-last-boot && {layout} && sync");
        self.again();
        Check.equal(self.read("/left-by-the-last-boot"), "left", "the boot went on, and the root is as the last boot left it");
        Check.that(self.read("/run/immutability-refused").contains(words), f"the reason is kept: {words}");
        Check.equal(self.machine.succeed("systemctl is-failed immutability-refused.service || true").trim(), "failed", "and it shows as a failed unit");
        Check.that(self.machine.succeed("journalctl -b --no-pager -u immutability-refused.service").contains(words), "whose journal has the reason");
        Check.that(self.machine.succeed("journalctl -b --no-pager -u immutability.service").contains("NOT RESET"), "as has the reset's own");
    }

    private void newerLayout() {
        print("A layout newer than this generation is left alone, the boot goes on, and it says that nothing was reset");
        var directory = "/run/top/@snapshots/.immutability";
        self.notReset(f"echo 99 > {directory}/format", "layout 99, written by a newer generation");
        self.notReset(f"rm {directory}/format && echo 2031.01.01 > {directory}/version", "a layout this generation does not know (2031.01.01)");
        self.notReset(f"echo newest > {directory}/format", "cannot be read (newest)");
        print("With its own layout back, the next boot resets again and has nothing to say");
        self.machine.succeed(f"echo 3 > {directory}/format && echo 2026.11.17 > {directory}/version && sync");
        self.again();
        self.machine.succeed("test ! -e /left-by-the-last-boot && test ! -e /run/immutability-refused && ! systemctl is-failed immutability-refused.service");
        print("A layout from before the numbers is brought up to this one");
        self.machine.succeed(f"rm {directory}/format && echo 2026.08.22 > {directory}/version && echo again > /left-by-the-last-boot && sync");
        self.again();
        self.machine.succeed("test ! -e /left-by-the-last-boot && test ! -e /run/immutability-refused");
        Check.equal(self.read("/.snapshots/.immutability/format") + " " + self.read("/.snapshots/.immutability/version"), "3 2026.11.17", "and both the number and the word are written");
    }

    public void check() {
        self.firstBoot();
        self.afterReset();
        self.restore();
        self.commands();
        self.newerLayout();
    }
}

int main(int argc, char** argv) {
    try {
        var lab = Lab(CLIArgs(argc, argv).require(0, "Supply VM descriptor"));
        var base = lab.settings().get("base").asString();
        lab.startAll();
        ResetScenario(lab.guest("machine"), base).check();
        lab.close();
        print(f"PASS: volumes reset from a base that is {base}, and what is persisted outlives it");
        return 0;
    } catch (string error) {
        print(f"FAIL: {error}");
        return 1;
    }
}
