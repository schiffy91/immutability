import Library.Console;
import Library.Timer;
import Library.FileSystem;
import Library.Map;
import Library.Platform;
import Library.Strings;
import Library.Vector;
import Library.Process;
import ./Log.btrc;
import ./ImmutabilityConstants.btrc;
import ./ImmutabilityPaths.btrc;

class ImmutabilityRun {
    public UnixShell shell;
    public Timer timer;
    public string top;
    public string logFile;
    public bool dryRun;
    private bool holding;
    private Map<string, string> held;  // a path and the owner it is still to get

    public ImmutabilityRun(bool dryRun) {
        self.shell = UnixShell();
        self.timer = Timer();
        self.timer.start();
        self.top = Environment.get("IMMUTABILITY_MOUNT_PATH", f"{ImmutabilityConstants.topBase()}.{Platform.pid()}");
        self.logFile = "";
        self.dryRun = dryRun;
        self.holding = false;
        self.held = {};
    }

    public string elapsed() {
        return f"[{self.timer.elapsed()}s]";
    }

    public string path(string rel) {
        var base = ImmutabilityPaths.trimTrailingSlashes(self.top);
        var child = ImmutabilityPaths.trimSlashes(rel);
        if (child.isEmpty()) { return base; }
        return PathTools.join(base, child);
    }

    public void log(string message) {
        var line = f"{self.elapsed()} {message}";
        Console.error(line);
        if (!self.logFile.isEmpty()) {
            FileSystem.appendText(self.logFile, line + "\n");
        }
    }

    public void enableFileLog(string path) {
        if (self.dryRun) { return; }
        self.logFile = path;
        FileSystem.mkdirp(PathTools.dirname(path));
        FileSystem.writeText(path, "");
    }

    public void fatal(string message) {
        throw f"{self.elapsed()} ERR {message}";
    }

    public ExecResult run(string command,
                          CommandOutput stdout = COMMAND_OUTPUT_COLLECT,
                          CommandOutput stderr = COMMAND_OUTPUT_COMBINE,
                          bool logFailure = true) {
        if (self.dryRun) {
            self.log(f"DRY {command}");
            return ExecResult(0, "", "", command);
        }
        self.log(command);
        return self.shell.run(command, stdout=stdout, stderr=stderr, logFailure=logFailure);
    }

    public void require(string command) {
        var result = self.run(command, stdout=COMMAND_OUTPUT_STREAM, stderr=COMMAND_OUTPUT_STREAM);
        if (!result.ok()) { self.fatal(f"Failed: {command}"); }
    }

    public void mkdirpInheriting(string path) {
        Vector<string> missing = [];
        var ancestor = path;
        while (!ancestor.isEmpty() && !FileSystem.exists(ancestor)) {
            missing.push(ancestor);
            var parent = PathTools.dirname(ancestor);
            if (parent.equals(ancestor)) { break; }
            ancestor = parent;
        }
        if (missing.isEmpty()) { return; }
        self.mkdirp(path);
        if (self.dryRun || !FileSystem.exists(ancestor)) { return; }
        for (int i = missing.len - 1; i >= 0; i--) { self.follow(ancestor, missing.get(i)); }
    }

    public void mkdirpFollowing(string base, string relativePath, string model) {  /* owners and modes as under model */
        var created = base;
        var like = model;
        for part in Strings.split(relativePath, "/") {
            if (part.isEmpty() || part.equals(".")) { continue; }
            var parent = created;
            created = PathTools.join(created, part);
            like = PathTools.join(like, part);
            if (FileSystem.exists(created)) { continue; }
            self.mkdirp(created);
            if (self.dryRun) { continue; }
            self.follow(FileSystem.isDir(like) && !FileSystem.isSymlink(like) ? like : parent, created);
        }
    }

    public void mkdirp(string path) {
        if (self.dryRun) {
            self.log(f"DRY mkdir -p {ShellWords.quote(path)}");
            return;
        }
        FileSystem.mkdirp(path);
    }

    public void removePath(string path) {
        if (self.dryRun) {
            self.log(f"DRY rm -rf {ShellWords.quote(path)}");
            return;
        }
        if (FileSystem.exists(path) || FileSystem.isSymlink(path)) {
            FileSystem.removeRecursive(path);
        }
    }

    // A rename and nothing else: it never copies, and it is done here, not by a child. The place it goes to
    // is not there yet, or is a file it replaces.
    public void renamePath(string source, string destination) {
        self.log(f"{self.dryRun ? "DRY " : ""}rename {ShellWords.quote(source)} {ShellWords.quote(destination)}");
        if (!self.dryRun && FileSystem.rename(source, destination) != 0) { self.fatal(f"Failed: rename {source} {destination}"); }
    }

    // The owner and the mode of `reference` for `path`. The mode is set here. The owner takes a child, for
    // want of a call for it in the library, and only where it is not the owner already: what root makes
    // beside what root owns needs none.
    public void follow(string reference, string path) {
        var wanted = self.owner(reference);
        if (self.dryRun || wanted != self.owner(path)) {
            if (self.holding && !self.dryRun) {
                self.held.set(path, wanted);
            } else {
                self.require(f"chown {wanted} {ShellWords.quote(path)}");
            }
        }
        if (!self.dryRun && FileSystem.chmod(path, FileSystem.stat(reference).mode & 0o7777) != 0) { self.fatal(f"Failed: mode of {reference} for {path}"); }
    }

    // The owner `path` has, or is still to get, as `chown` takes it.
    private string owner(string path) {
        if (self.held.has(path)) { return self.held.get(path); }
        var status = FileSystem.stat(path);
        return f"{status.uid}:{status.gid}";
    }

    // From here to `settleOwners` the owners `follow` would set are kept, and then set by one child for each
    // owner, not one for each path. Nothing that is held may be moved before it is settled.
    public void holdOwners() { self.holding = true; }

    public void settleOwners() {
        self.holding = false;
        Vector<string> owners = [];
        for path in self.held.keys() {
            if (!owners.contains(self.held.get(path))) { owners.push(self.held.get(path)); }
        }
        for owner in owners {
            Vector<string> paths = [];
            for path in self.held.keys() {
                if (self.held.get(path) == owner) { paths.push(ShellWords.quote(path)); }
            }
            self.require(f"chown {owner} -- {paths.join(" ")}");
        }
        self.held = {};
    }
}
