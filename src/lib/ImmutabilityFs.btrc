import Library.FileSystem;
import Library.Process;
import Library.Strings;
import Library.Vector;
import ./ImmutabilityBtrfs.btrc;
import ./ImmutabilityPaths.btrc;
import ./ImmutabilityRun.btrc;

class ImmutabilityFs {
    public ImmutabilityRun run;

    public ImmutabilityFs(ImmutabilityRun run) {
        self.run = run;
    }

    public bool exists(string path) {
        return FileSystem.exists(path) || FileSystem.isSymlink(path);
    }

    public bool isSubvolume(string path) {
        if (!FileSystem.exists(path)) { return false; }
        var result = self.run.shell.run(ImmutabilityBtrfs.show(path), logFailure=false);
        return result.ok();
    }

    public bool isReadonly(string path) {
        var result = self.run.shell.run(ImmutabilityBtrfs.getReadonly(path), logFailure=false);
        return result.ok() && result.stdout().contains("ro=true");
    }

    public bool mounted(string path) {
        var result = self.run.shell.run(f"findmnt --mountpoint {ShellWords.quote(path)}", logFailure=false);
        return result.ok();
    }

    public int compareDeepestFirst(string left, string right) {
        var leftDepth = Strings.count(left, "/");
        var rightDepth = Strings.count(right, "/");
        if (leftDepth != rightDepth) { return rightDepth - leftDepth; }
        if (left.len() != right.len()) { return right.len() - left.len(); }
        return Strings.compare(left, right);
    }

    public void pushChildSorted(Vector<string> paths, string path) {
        var index = 0;
        while (index < paths.len && self.compareDeepestFirst(paths.get(index), path) <= 0) {
            index++;
        }
        paths.insert(index, path);
    }

    public Vector<string> childSubvolumes(string path) {
        Vector<string> result = [];
        if (!FileSystem.isDir(path)) { return result; }
        var listed = self.run.run(ImmutabilityBtrfs.listChildren(path));
        if (!listed.ok()) { self.run.fatal(f"list {path}"); }
        for line in Strings.split(listed.stdout(), "\n") {
            var marker = Strings.find(line, " path ", 0);
            if (marker < 0) { continue; }
            var child = line.substring(marker + 6, line.len() - (marker + 6)).trim();
            var childPath = self.run.path(child);
            if (ImmutabilityPaths.ancestor(path, childPath)) {
                self.pushChildSorted(result, childPath);
            }
        }
        return result;
    }

    public void deleteSubvolume(string path) {
        if (!self.exists(path)) { return; }
        if (!self.isSubvolume(path)) {
            self.run.fatal(f"refusing to delete non-subvolume: {path}");
        }
        var children = self.childSubvolumes(path);
        for child in children {
            self.run.require(ImmutabilityBtrfs.deleteSubvol(child));
        }
        self.run.require(ImmutabilityBtrfs.deleteSubvol(path));
    }

    public void makeSubvolume(string path) {
        self.run.mkdirp(PathTools.dirname(path));
        self.run.require(ImmutabilityBtrfs.createSubvol(path));
    }

    public void snapshot(string source, string destination, bool readonly) {
        if (!FileSystem.isDir(source)) {
            self.run.fatal(f"Source missing: {source}");
        }
        self.deleteSubvolume(destination);
        self.run.require(ImmutabilityBtrfs.snapshot(source, destination, readonly));
        if (!readonly) {
            self.run.require(ImmutabilityBtrfs.clearReadonly(destination));
        }
    }

    public string sourcePath(string live, string clean, string relativePath) {
        var livePath = PathTools.join(live, relativePath);
        if (self.exists(livePath)) { return livePath; }
        if (clean.isEmpty()) { return ""; }  /* an empty base has no snapshot to fall back to */
        var cleanPath = PathTools.join(clean, relativePath);
        if (self.exists(cleanPath)) { return cleanPath; }
        return "";
    }

    // A clone where btrfs allows one. It refuses to clone a file marked no-copy-on-write (a database, a search
    // index) into a new subvolume, and that file is copied instead.
    public void copyPath(string source, string destination) {
        self.run.mkdirp(PathTools.dirname(destination));
        self.run.require(f"cp --reflink=auto -a {ShellWords.quote(source)} {ShellWords.quote(destination)}");
    }

    public void copyDirectoryContents(string source, string destination) {
        if (!FileSystem.isDir(source)) { return; }
        var nested = self.childSubvolumes(source);
        if (!nested.isEmpty()) {
            var paths = nested.join(" ");
            self.run.fatal(f"nested subvolumes in persisted dir: {paths}");
        }
        var sourceContents = ShellWords.quote(PathTools.join(source, "."));
        var quotedDestination = ShellWords.quote(destination);
        self.run.require(f"cp --reflink=auto -a {sourceContents} {quotedDestination}");
    }

    // A store that is being filled is not the store yet: a copy that fails half way must not leave a
    // subvolume the next run takes for the persisted data and mounts over the real folder.
    public void seedSubvolume(string store, string source) {
        var filling = f"{store}.filling";
        self.deleteSubvolume(filling);  /* what an earlier failure left */
        self.makeSubvolume(filling);
        try {
            if (!source.isEmpty()) {
                self.copyDirectoryContents(source, filling);
                self.matchOwnerAndMode(source, filling);
            }
        } catch (string error) {
            self.deleteSubvolume(filling);
            throw error;
        }
        self.run.renamePath(filling, store);
    }

    public void matchOwnerAndMode(string source, string destination) {
        if (!FileSystem.exists(source) || !FileSystem.isDir(destination)) { return; }
        self.run.follow(source, destination);
    }
}
